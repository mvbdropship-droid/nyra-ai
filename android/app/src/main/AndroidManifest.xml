<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android:android="http://android.com">

    <application android:android:allowBackup="true"
        android:android:icon="@mipmap/ic_launcher"
        android:android:label="@string/app_name"
        android:android:roundIcon="@mipmap/ic_launcher_round"
        android:android:supportsRtl="true"
        android:android:theme="@style/AppTheme">

        <activity android:android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:android:name=".MainActivity"
            android:android:label="@string/title_activity_main"
            android:android:theme="@style/AppTheme.NoActionBarLaunch"
            android:android:launchMode="singleTask"
            android:android:exported="true">

            <intent-filter>
                <action android:android:name="android.intent.action.MAIN" />
                <category android:android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:android:name="android.intent.action.ASSIST" />
                <category android:android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <intent-filter>
                <action android:android:name="android.intent.action.VOICE_COMMAND" />
                <category android:android:name="android.intent.category.DEFAULT" />
            </intent-filter>

        </activity>

        <provider android:android:name="androidx.core.content.FileProvider"
            android:android:authorities="${applicationId}.fileprovider"
            android:android:exported="false"
            android:android:grantUriPermissions="true">
            <meta-data android:android:name="android.support.FILE_PROVIDER_PATHS"
                android:android:resource="@xml/file_paths" />
        </provider>
    </application>

    <uses-permission android:android:name="android.permission.INTERNET" />
    <uses-permission android:android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:android:name="android.permission.CAMERA" />
    <uses-permission android:android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:android:name="android.permission.POST_NOTIFICATIONS" />

</manifest>